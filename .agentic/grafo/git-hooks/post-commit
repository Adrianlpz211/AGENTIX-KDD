#!/bin/sh
# Agentic KDD managed hook
# Encola ESTE commit (SHA, parent, tree) y lanza el worker en segundo plano.
# Nunca bloquea: el commit ya se hizo.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
RUNNER="$ROOT/.agentic/grafo/hook-runner.cjs"
[ -f "$RUNNER" ] || exit 0
command -v node >/dev/null 2>&1 || { echo "  ⚠️  Agentic KDD: node no está en el PATH — el commit no quedó encolado"; exit 0; }
node "$RUNNER" post-commit "$@" || true
exit 0
