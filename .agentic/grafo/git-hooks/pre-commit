#!/bin/sh
# Agentic KDD managed hook
# Toda la lógica vive en hook-runner.cjs (Node): lee el ÍNDICE, no el worktree,
# y trata nombres con espacios o Unicode como datos.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
RUNNER="$ROOT/.agentic/grafo/hook-runner.cjs"
[ -f "$RUNNER" ] || exit 0
if ! command -v node >/dev/null 2>&1; then
  [ "$AKDD_SKIP_GATES" = "1" ] && exit 0
  echo "  COMMIT BLOQUEADO — node no está en el PATH: los gates de Agentic KDD no pudieron revisar el commit."
  echo "  Si de verdad no aplica:  AKDD_SKIP_GATES=1 git commit ..."
  exit 1
fi
exec node "$RUNNER" pre-commit "$@"
