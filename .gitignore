node_modules/
.env
.env.local
.DS_Store
*.log
dist/
build/
.next/
__pycache__/
*.pyc
vendor/

# Datos del proyecto (memoria del grafo) y caché de modelos — NO publicar
.agentic/memoria.db
# Sidecars de SQLite en modo WAL: los crea cualquier lectura (arrancar el
# dashboard basta) y son estado transitorio, nunca fuente.
.agentic/memoria.db-wal
.agentic/memoria.db-shm
.agentic/.model_cache/

# Credenciales del modo colaborativo (URL + token de Turso) — NUNCA subir
.agentic/collab.json

# Artefactos de auditoría / archivos rotos renombrados — internos, NO publicar
*.ROTO*
.agentic/_instance_id
.agentic/_tarea_en_curso.json
.agentic/_ciclo_actual.json
.agentic/_tdd_ultimo.json
.agentic/_tdd_state.json
.agentic/_pipeline/
.agentic/_cache/
.agentic/_effort/
.agentic/_context/
.agentic/_teams/
.agentic/_restore/
.agentic/_whatsapp/
.agentic/_ntfy/
.agentic/_oraculo/
.agentic/_hooks-host.json
.agentic/checkpoint.md

# ── Estado generado del propio repo ─────────────────────────────────────────
# Lo escribe el motor en cada ciclo y se regenera solo: no es fuente, y
# versionarlo produce conflictos en cada post-commit. Ya estaba en .npmignore.
.agentic/diff-overlay.json
.agentic/knowledge-graph.json
.agentic/tour.json
.agentic/llms.txt
.agentic/llms-full.txt

# ── Configuración de máquina ────────────────────────────────────────────────
# launch.json filtró una ruta absoluta de cliente (C:\lumo) al repo público.
# Es configuración local, no del producto: no vuelve a viajar.
.claude/launch.json
.claude/settings.local.json
scripts/preview-lumo-dashboard.cjs

# ── Evidencia interna y empaquetados de trabajo ─────────────────────────────
repomix-output.xml
docs/benchmarks/
docs/benchmarks$dest/
docs/superpowers/

# ── Documentos personales y de sesión ───────────────────────────────────────
*.pdf
life-logbook-*.md
chat-migration-*.md
INFORME-*.md
SESION-RESUMEN.md
PLAN-7-PIEZAS.md
PLAN-CLICKUP-BRIDGE.md

# Bibliotecas de distribución del dashboard (no estado del proyecto)
!.agentic/grafo/vendor/
!.agentic/grafo/vendor/**
.agentic/_executions/
.agentic/_hooks-eventos.jsonl

# ── 3.20: hooks de host instalados en ESTA máquina (ruta absoluta dentro) ──
# host-guard los escribe con la ruta del checkout; son configuración local,
# misma clase de fuga que launch.json. Se regeneran con akdd host-hooks install.
.claude/settings.json
.codex/

# ── 3.20: trazas, salidas de la barrera de release y capturas del navegador ─
# telemetria/ son trazas por ciclo de esta máquina. release-*/ trae el tarball
# (1.5 MB) y un verification.json con rutas temporales locales; el workflow lo
# sube como artifact, no viaja por Git. *-actual/ y *-baseline/ son PNG de
# comparación; la referencia real vive en test/fixtures/dashboard-baseline/.
.agentic/telemetria/
_output/release-*/
_output/*-actual/
_output/*-baseline/

# Bitácora de la sesión de actualización (rutas de escritorio dentro) — misma
# regla que life-logbook-*.md: documento de sesión, no fuente.
.agentic/actualizacion-agentix.md

# Cola del post-commit (H21): SHAs pendientes y ACK por commit — estado de máquina
.agentic/_hooks/

# Mismo caso que en .npmignore: estado escrito en un .agentic anidado
**/.agentic/_hooks-eventos.jsonl

# akdd update: respaldos verificados de la memoria, journals e informes (3.20.1). NUNCA se versionan.
.agentic/_update/
# 3.20.1: originales recuperables (pueden contener salidas de herramientas del cliente), caché y cola de memoria
.agentic/_evidence/
.agentic/memoria.db.bak-*

# Copia instalada del mod de Claude Code (la fuente vive en .agentic/mods/) — la pone `akdd mod on`
.claude/skills/agentix-live/
.agentic/_mods-host.json
