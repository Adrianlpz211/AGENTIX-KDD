{
  "name": "agentic-kdd",
  "version": "3.23.4",
  "description": "Autonomous development pipeline — aa: · ag: · audit: · AST graph · Harness · Specs · Impact analysis · Decision trail · Metrics · MCP server. Works with Cursor and Claude Code.",
  "bin": {
    "akdd": "bin/akdd.js"
  },
  "scripts": {
    "prepublishOnly": "node scripts/release-check.cjs --publish",
    "version": "node scripts/sync-version.cjs && git add .agentic/grafo/framework.json .agentic/config.md",
    "test": "node scripts/run-tests.cjs",
    "test:smoke": "node bin/akdd.js --version",
    "prepare": "node -e \"var fs=require('fs');fs.chmodSync('bin/akdd.js','755')\"",
    "release:check": "node scripts/release-check.cjs",
    "release:verify": "node scripts/verify-published.cjs"
  },
  "keywords": [
    "ai",
    "cursor",
    "claude-code",
    "autonomous",
    "development",
    "pipeline",
    "kdd",
    "knowledge-driven",
    "agentic",
    "sqlite",
    "dashboard",
    "mcp",
    "ast",
    "harness",
    "specs",
    "memory"
  ],
  "author": "Adrianlpz211",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adrianlpz211/AGENTIX-KDD.git"
  },
  "homepage": "https://github.com/Adrianlpz211/AGENTIX-KDD",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "chalk": "^4.1.2",
    "fs-extra": "^11.2.0",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "sql.js": "^1.10.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.6.0",
    "playwright-core": "^1.61.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "files": [
    "bin/",
    "src/",
    ".agentic/grafo/",
    "!.agentic/grafo/*.log",
    ".agentic/agentes/",
    ".agentic/nucleo-reglas.md",
    ".audit/",
    ".cursor/rules/",
    "templates/seed/",
    "CLAUDE.md",
    ".cursorrules",
    "dashboard.cjs",
    "AGENTS.md",
    "README.md",
    "README.es.md",
    "LICENSE",
    "PUBLICACION-3.20.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
